PORT=3000
NODE_ENV=development

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=domain_monitor

# API Security
API_KEY=your-secret-api-key-here

# Signal Bot
# Base URL for signal-cli-rest-api
SIGNAL_API_URL=http://localhost:8080
SIGNAL_ACCOUNT=+1234567890
# Get group ID from: curl http://localhost:8080/v1/groups/<your-number>
# The format should be: group.XXXXX (the "id" field from the response)
SIGNAL_GROUP_ID=group.your-group-id-here

# Bot Behavior
BOT_TIMEOUT_MS=10000
BOT_RETRY_ATTEMPTS=3

# VipTalk Bot
VIPTALK_API_URL=https://api.viptalk.org
VIPTALK_BOT_TOKEN=your-bot-token-here
VIPTALK_ROOM_ID=!your-room-id:matrix-uat.viptalk.org

# Provider: signal | viptalk
NOTIFICATION_PROVIDER=signal

# SerpAPI (Search Bot) — https://serpapi.com
SERPAPI_API_KEY=
SERPAPI_ENGINE=google
SERPAPI_GL=vn
SERPAPI_HL=vi
SERPAPI_LOCATION=Vietnam
SERPAPI_GOOGLE_DOMAIN=google.com
SERPAPI_NUM=10
SERPAPI_DEVICE_MB=mobile
