{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "projects": {
    "search": {
      "type": "application",
      "root": "cmd/search",
      "entryFile": "main"
    },
    "monitor": {
      "type": "application",
      "root": "cmd/monitor",
      "entryFile": "main"
    }
  }
}
